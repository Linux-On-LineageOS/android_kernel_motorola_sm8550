#
# Please avoid changing the Qualcomm defconfig files and use this file to
# add any Motorola-specific configuration changes that are applicable to
# userdebug, eng, and user builds.
#
CONFIG_RTWO_DTB=y
CONFIG_USB_REDRIVER_PS5169=m
CONFIG_RICHTAP_FOR_PMIC_ENABLE=y
CONFIG_UFSFEATURE=y
CONFIG_UFSHID=y
CONFIG_UFSSID=y
CONFIG_UFSFBO=y
CONFIG_UFSFBO_POC=y
CONFIG_SCHED_MOTO_UNFAIR=m


# Lindroid
CONFIG_SYSVIPC=y
CONFIG_UTS_NS=y
CONFIG_PID_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_DRM_LINDROID_EVDI=y
